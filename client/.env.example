# ──────────────────────────────────────────────
# CinemaSync Client — Environment Variables
# Copy to client/.env for local dev
# Set ALL of these in Vercel dashboard → Settings → Environment Variables
# IMPORTANT: Vercel rebuilds the frontend with these baked in at build time
# ──────────────────────────────────────────────

# API URL — leave as /api for same-origin Vercel deployment
VITE_API_URL=/api

# Google OAuth Client ID
# Get from: console.cloud.google.com → APIs → Credentials → OAuth 2.0 Client IDs
# Add authorized origins: https://cinema-sync-six.vercel.app and http://localhost:5173
# Without this, the Google Sign-In button will not appear
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Stripe publishable key (only needed for live Stripe payment UI)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
