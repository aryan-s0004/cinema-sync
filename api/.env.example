# Backend environment variables
# Copy this file to .env and fill in the values
# NEVER commit the actual .env file

# App
NODE_ENV=development

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/cinemasync?retryWrites=true&w=majority

# Frontend origin (optional for stricter CORS)
CLIENT_URL=https://your-domain.vercel.app

# JWT secret - used for access, refresh, and ticket QR signing unless specific overrides are set
JWT_SECRET=replace_with_long_random_secret
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Ticket QR signing secret (optional override; defaults to JWT_SECRET)
TICKET_QR_SECRET=

# Google OAuth (optional)
GOOGLE_CLIENT_ID=

# Movie data source (tmdb or database)
MOVIE_PROVIDER=tmdb
MOVIE_API_URL=https://api.themoviedb.org/3
TMDB_API_KEY=

# Seat & booking windows
SEAT_LOCK_MINUTES=10
PAYMENT_WINDOW_MINUTES=10
PAYMENT_OTP_EXPIRY_MINUTES=3

# Payment provider: "stripe" or "mock"
PAYMENT_PROVIDER=stripe
PAYMENT_WEBHOOK_SECRET=replace_with_webhook_signature_secret
PAYMENT_DEBUG_PREVIEW=false

# Stripe keys
# STRIPE_SECRET_KEY is mandatory for real Stripe payments.
# STRIPE_PUBLISHABLE_KEY is required when using embedded Stripe Elements.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (nodemailer / Gmail)
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
EMAIL_SERVICE=gmail
EMAIL_FALLBACK_TO_LOG=true

# Admin notification email (optional)
ADMIN_NOTIFICATION_EMAIL=

# SMS (optional)
SMS_FALLBACK_TO_LOG=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Caching & performance
CACHE_MAX_KEYS=500
MONGO_MAX_POOL_SIZE=100
MONGO_MIN_POOL_SIZE=5
