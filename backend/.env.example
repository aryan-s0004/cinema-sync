STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
ADMIN_NOTIFICATION_EMAIL=

TICKET_SCAN_OPEN_MINUTES_BEFORE=30
TICKET_SCAN_CLOSE_MINUTES_AFTER=0
BOOKING_EXPIRY_SWEEP_SECONDS=30
CACHE_MAX_KEYS=500
RATE_LIMIT_CLEANUP_MS=300000
MONGO_MAX_POOL_SIZE=100
MONGO_MIN_POOL_SIZE=5
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MONGO_SOCKET_TIMEOUT_MS=45000
SERVER_KEEP_ALIVE_TIMEOUT_MS=65000
SERVER_HEADERS_TIMEOUT_MS=66000
SERVER_REQUEST_TIMEOUT_MS=30000

OPENAI_API_KEY=
