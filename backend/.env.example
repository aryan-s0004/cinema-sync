# Do not commit API keys or live secrets.
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/cinemasync_database
CLIENT_URL=http://localhost:5173

JWT_ACCESS_SECRET=replace_with_long_random_secret
JWT_REFRESH_SECRET=replace_with_long_random_secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
TICKET_QR_SECRET=replace_with_dedicated_qr_signing_secret
GOOGLE_CLIENT_ID=

